{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sinnfaden-bug-relay",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "observability": { "enabled": false },
  "vars": {
    "GITHUB_REPOSITORY": "ixcxyy/Sinnfaden",
    "ALLOWED_RELEASES": "0.4.1+5,0.4.2+6",
    "MAX_NEW_ISSUES_PER_DAY": "20"
  },
  "durable_objects": { "bindings": [{ "name": "INBOX", "class_name": "BugInbox" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BugInbox"] }],
  "ratelimits": [{ "name": "REPORT_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }]
}
